# Copy this file to .env and fill in what you need. Never commit .env.

# development | production (production refuses to start without real secrets and https URLs)
ENVIRONMENT=development

# --- Addresses -------------------------------------------------------------------------
# Where students open the web app (used in emails and after sign-in redirects).
APP_URL=http://localhost:5173
# Public address of this API, used for OAuth redirect URIs. In development the Vite
# server forwards /api to the backend, so it's the same as APP_URL.
# Production example: API_URL=https://api.defog.fit
API_URL=http://localhost:5173

# --- Database: Supabase Postgres -------------------------------------------------------
# Supabase dashboard -> Connect -> "Session pooler" connection string (works on IPv4).
# Paste it as-is; Defog adds sslmode=require for Supabase hosts. Percent-encode special
# characters in the password (e.g. @ -> %40).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Secrets ----------------------------------------------------------------------------
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts Canvas/Google tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it changes, students must reconnect Canvas and Google Calendar.
TOKEN_ENCRYPTION_KEY=

# --- Email (verification and password-reset links) -------------------------------------
# console: links are printed in the server log (development). smtp: send for real.
EMAIL_BACKEND=console
EMAIL_FROM=Defog <no-reply@defog.fit>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Google: sign-in and Google Calendar (one OAuth client) ----------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URIs (use your API_URL):
#   http://localhost:5173/api/auth/google/callback
#   http://localhost:5173/api/connections/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile app deep link for Google sign-in, e.g. defog://auth (leave empty until the app exists)
MOBILE_REDIRECT_URI=

# --- Canvas ----------------------------------------------------------------------------
# Developer keys from a school's Canvas admin, as JSON (students elsewhere use access tokens):
# CANVAS_OAUTH_CLIENTS={"https://canvas.upenn.edu": {"client_id": "...", "client_secret": "..."}}
CANVAS_OAUTH_CLIENTS=
# Optional: only allow these Canvas hosts (comma-separated). Empty = any public https host.
CANVAS_ALLOWED_HOSTS=

# --- Sync -------------------------------------------------------------------------------
# In-process sync loop. Turn it off on hosts that pause idle servers (Cloud Run), and have a
# scheduler POST /api/internal/sync with the header X-Sync-Secret: <SYNC_TRIGGER_SECRET>.
BACKGROUND_SYNC_ENABLED=true
# Empty = /api/internal/sync is off. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNC_TRIGGER_SECRET=
SYNC_INTERVAL_MINUTES=90
CHAT_SYNC_STALE_MINUTES=60

# --- AI provider: mock | anthropic | openai --------------------------------------------
LLM_PROVIDER=mock

# Claude (https://platform.claude.com) - used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible API - used when LLM_PROVIDER=openai. The model must support
# tool (function) calling for the chatbot to read Canvas and calendar data.
# Free local option: install Ollama, run `ollama pull llama3.2`, then use:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.meta.ai/v1
OPENAI_MODEL=muse-spark-1.1

# Cost guards
MAX_OUTPUT_TOKENS=1024
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=8000
MAX_TOOL_ROUNDS=6
DAILY_TOKEN_LIMIT=200000

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://defog.fit,https://www.defog.fit

# Login protection
PASSWORD_BREACH_CHECK=true
